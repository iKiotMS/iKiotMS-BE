PORT=3800
NODE_ENV=development

CONNECTION_STRING=mongodb://localhost:27017/ikiotms

ACCESS_TOKEN_SECRET=your-super-secret-access-token-key-change-this-in-production
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this-in-production
JWT_SECRET=your-fallback-secret-key-change-this-in-production

# SePay – company bank account for subscription payments
SEPAY_ACCOUNT_NUMBER=0123456789
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NAME=CONG TY IKIOT
# API key SePay gửi kèm mỗi webhook — lấy trong dashboard SePay > Webhook settings
SEPAY_WEBHOOK_API_KEY=your-sepay-webhook-api-key

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-email-password

# Firebase Admin – reserved for future push notifications (not used for OTP anymore)
# Lấy từ Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Giữ nguyên trên 1 dòng, xuống dòng được escape bằng \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# eSMS – gửi OTP SMS thật khi đăng ký (https://esms.vn)
# Để trống khi dev: OTP in ra console thay vì gửi SMS thật
ESMS_API_KEY=your-esms-api-key
ESMS_SECRET_KEY=your-esms-secret-key
ESMS_BRANDNAME=Baotrixemay
# Khi NODE_ENV != production: token rỗng hoặc giá trị này sẽ bỏ qua verify (mock OTP khi dev)
DEV_OTP_BYPASS_TOKEN=DEV_BYPASS